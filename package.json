{
  "name": "mcp-openfda",
  "version": "2.0.0",
  "description": "TypeScript MCP server for FDA drug label search, safety sections, indications, full labels, and field aggregation.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "clean": "node -e \"import('node:fs').then(fs=>fs.rmSync('dist',{recursive:true,force:true}))\"",
    "prepack": "npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "openfda",
    "fda",
    "drug-labels",
    "drug-safety"
  ],
  "author": "Aki894",
  "license": "GPL-3.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "mcp-openfda": "./dist/index.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "README.en.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Aki894/mcp-openfda.git"
  },
  "bugs": {
    "url": "https://github.com/Aki894/mcp-openfda/issues"
  }
}
